{
  "version": 3,
  "mode": "${DWS_CHAT_AGENT_MODE}",
  "timezone": "Asia/Shanghai",
  "self": {
    "name": "${DWS_CHAT_AGENT_SELF_NAME}",
    "open_dingtalk_id": "${DWS_CHAT_AGENT_SELF_OPEN_ID}"
  },
  "contacts": "${DWS_CHAT_AGENT_CONTACTS_JSON}",
  "quiet_window_seconds": 5,
  "human_cooldown_seconds": 600,
  "history_limit": 80,
  "event_reconcile_interval_seconds": 60,
  "event_reconcile_lookback_seconds": 7200,
  "open_id_poll_interval_seconds": 5,
  "recent_context_messages": 100,
  "recent_context_chars": 12000,
  "monitor_interval_seconds": 5,
  "max_replans": 12,
  "max_parallel_conversations": 10,
  "max_reply_chars": 4000,
  "rate_limit": {
    "per_contact_per_hour": 12,
    "global_per_hour": 40
  },
  "workspace_root": "${DWS_CHAT_AGENT_WORKSPACE_ROOT}",
  "worktree_root": "${DWS_CHAT_AGENT_WORKTREE_ROOT}",
  "state_dir": "state",
  "task_memory": {
    "inactive_days": 2
  },
  "skills": {
    "humanizer_zh": "~/.agents/skills/humanizer-zh/SKILL.md",
    "answer_me_with_html": "~/.agents/skills/answer-me-with-html/SKILL.md",
    "answer_me_script": "~/.agents/skills/answer-me-with-html/scripts/am.mjs"
  },
  "agents": {
    "pi-front": {
      "driver": "pi",
      "protocol": "pi-rpc",
      "command": [
        "pi"
      ],
      "model": "",
      "reasoning_effort": "low",
      "read_only": true,
      "timeout_seconds": 0,
      "options": {
        "tools": null,
        "extensions": []
      },
      "extra_args": []
    },
    "codex-front": {
      "driver": "codex",
      "protocol": "codex-app-server",
      "command": [
        "${DWS_CHAT_AGENT_CODEX_BINARY}"
      ],
      "model": "gpt-5.6-terra",
      "reasoning_effort": "medium",
      "read_only": true,
      "timeout_seconds": 0,
      "options": {
        "web_search": "disabled"
      }
    },
    "codex-worker": {
      "driver": "codex",
      "protocol": "codex-app-server",
      "command": [
        "${DWS_CHAT_AGENT_CODEX_BINARY}"
      ],
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high",
      "read_only": false,
      "timeout_seconds": 10800,
      "options": {
        "sandbox": "danger-full-access",
        "web_search": "disabled",
        "mcp": {
          "grafana-dev": true,
          "grafana-prod-logging": true,
          "hsj-atlassian": {
            "directTools": [
              "jira_get_issue",
              "jira_search",
              "jira_get_transitions",
              "confluence_search",
              "confluence_get_page"
            ]
          },
          "engram": true
        },
        "service_tools_mcp": true,
        "skills": [
          "humanizer-zh",
          "answer_me_with_html"
        ]
      }
    },
    "claude-worker": {
      "driver": "claude",
      "protocol": "claude-stream-json",
      "command": [
        "claude"
      ],
      "model": "sonnet",
      "reasoning_effort": "",
      "read_only": false,
      "timeout_seconds": 10800,
      "options": {
        "mcp": {
          "grafana-dev": true,
          "grafana-prod-logging": true,
          "hsj-atlassian": {
            "directTools": [
              "jira_get_issue",
              "jira_search",
              "jira_get_transitions",
              "confluence_search",
              "confluence_get_page"
            ]
          },
          "engram": true
        },
        "service_tools_mcp": true,
        "skills": [
          "humanizer-zh",
          "answer_me_with_html"
        ]
      }
    },
    "pi-worker": {
      "driver": "pi",
      "protocol": "pi-rpc",
      "command": [
        "pi"
      ],
      "model": "",
      "reasoning_effort": "high",
      "read_only": false,
      "timeout_seconds": 10800,
      "worktree_repo": "",
      "options": {
        "extensions": "${DWS_CHAT_AGENT_PI_WORKER_EXTENSIONS_JSON}",
        "mcp": {
          "grafana-dev": {
            "directTools": [
              "query_loki_logs",
              "query_prometheus",
              "get_datasource",
              "list_datasources",
              "search_dashboards",
              "get_dashboard_summary"
            ]
          },
          "grafana-prod-logging": {
            "directTools": [
              "query_loki_logs",
              "query_prometheus",
              "get_datasource",
              "list_datasources",
              "search_dashboards",
              "get_dashboard_summary"
            ]
          },
          "hsj-atlassian": {
            "directTools": [
              "jira_get_issue",
              "jira_search",
              "jira_get_transitions",
              "confluence_search",
              "confluence_get_page"
            ]
          },
          "engram": true
        },
        "skills": [
          "humanizer_zh",
          "answer_me_with_html"
        ]
      }
    },
    "dsh-worker": {
      "driver": "dsh",
      "protocol": "dsh-headless-jsonl",
      "command": [
        "dsh"
      ],
      "model": "",
      "reasoning_effort": "",
      "read_only": false,
      "timeout_seconds": 10800,
      "worktree_repo": "",
      "options": {
        "dsh_profile": "headless",
        "dsh_patches": [
          "deploy/dsh/dws-worker.patch.yml"
        ],
        "service_tools_mcp": true,
        "task_cli": true,
        "mcp": {
          "grafana-dev": true,
          "grafana-prod-logging": true,
          "hsj-atlassian": {
            "directTools": [
              "jira_get_issue",
              "jira_search",
              "jira_get_transitions",
              "confluence_search",
              "confluence_get_page"
            ]
          },
          "engram": true
        },
        "skills": [
          "humanizer-zh",
          "answer_me_with_html"
        ]
      },
      "environment": {},
      "extra_args": [],
      "fallbacks": []
    }
  },
  "workflows": {
    "active": "pi-default",
    "presets": {
      "pi-default": {
        "supplement_strategy": "steer",
        "supplement_prompt": "prompts/supplement.md",
        "auto_messages": {
          "ack_enabled": true,
          "ack": "已收到消息，正在处理中。"
        },
        "front": {
          "label": "快速前台",
          "agent": "pi-front",
          "prompt": "prompts/front.md"
        },
        "worker": {
          "label": "执行 Agent",
          "agent": "pi-worker",
          "prompt": "prompts/worker.md"
        }
      }
    }
  },
  "dws": {
    "binary": "dws",
    "profile": "${DWS_CHAT_AGENT_DWS_PROFILE}",
    "ai_tag": true,
    "streaming_cards": true
  },
  "security": {
    "max_message_chars": 12000
  },
  "watches": [
    {
      "source": "jira",
      "name": "ZKAI 新 issue 指派给我",
      "jql": "assignee = currentUser() AND created >= -1d ORDER BY created DESC",
      "projects": [
        "ZKAI"
      ],
      "instruction": "分析这个 issue：总结要点、判断优先级与影响面，把结论作为评论回写。不修改 issue 状态。"
    },
    {
      "source": "gitlab",
      "name": "zk-ai 核心仓库新 MR",
      "projects": [
        "xk/product/zk-ai/change-monitor",
        "xk/product/zk-ai/zkai-gateway"
      ],
      "instruction": "审查这个 MR：列出变更要点与风险，把结论作为评论回写。不合并不修改。"
    }
  ],
  "watch_interval_seconds": 300
}
